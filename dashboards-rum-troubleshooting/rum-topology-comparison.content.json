                                                "title":  "UPSTREAM - Applications",
                                                "description":  "Frontend/Web Application identity selected as upstream.",
                                                "query":  "smartscapeNodes \"FRONTEND\"\n| filter name == $frontend_upstream\n| fields\n    `Application ID` = id,\n    `Application name` = name,\n    `Classic application ID` = id_classic,\n    `Entity type` = type\n| sort `Application name` asc, `Application ID` asc\n| limit 20",
