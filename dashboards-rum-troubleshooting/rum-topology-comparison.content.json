                  "section_process_groups":  {
                                                 "type":  "markdown",
                                                 "content":  "## 03 - PROCESS GROUPS\n\nProcess Group is a compatibility grouping derived from processes. The table keeps the Dynatrace Process Group ID and detected name visible for human reading."
                                             },
                  "upstream_process_groups":  {
                                                  "type":  "data",
                                                  "title":  "UPSTREAM - Process groups",
                                                  "description":  "Process groups behind services called by the upstream frontend.",
                                                  "query":  "smartscapeNodes \"FRONTEND\"\n| filter name == $frontend_upstream\n| traverse edgeTypes: {calls}, targetTypes: {SERVICE}, direction: forward\n| traverse edgeTypes: {runs_on}, targetTypes: {PROCESS}, direction: forward\n| filter isNotNull(dt.process_group.id) or isNotNull(dt.process_group.detected_name)\n| dedup dt.process_group.id, dt.process_group.detected_name\n| fields\n    `Process Group ID` = dt.process_group.id,\n    `Process Group name` = dt.process_group.detected_name\n| sort `Process Group name` asc, `Process Group ID` asc\n| limit 100",
                                                  "visualization":  "table",
                                                  "visualizationSettings":  {
                                                                                "autoSelectVisualization":  false,
                                                                                "table":  {
                                                                                              "rowDensity":  "condensed",
                                                                                              "columnWidthStrategy":  "content",
                                                                                              "enableSparklines":  false,
